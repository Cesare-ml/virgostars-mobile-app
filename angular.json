{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "virgostars-mobile": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/virgostars-mobile",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "output": "assets",
                "glob": "**/*",
                "input": ".local/frontend/assets"
              },
              {
                "output": "assets",
                "glob": "**/*",
                "input": "src/assets"
              },
              {
                "output": "assets",
                "glob": "**/*",
                "input": "src/chart-symbols"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "virgostars-mobile:build"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
