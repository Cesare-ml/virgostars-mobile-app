{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VirgoStars runtime_info v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "mode",
    "schema_version"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "ios",
        "desktop-preview"
      ]
    },
    "mode": {
      "const": "prototype"
    },
    "schema_version": {
      "const": 1
    }
  }
}
