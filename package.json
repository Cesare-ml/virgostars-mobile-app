{
  "name": "virgostars-mobile-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Android-first, iOS-ready VirgoStars experimental offline-first mobile app",
  "scripts": {
    "dev": "ng serve --host 0.0.0.0 --port 1420",
    "build": "ng build",
    "test:contract": "node --test tests/*.test.mjs",
    "check": "npm run test:contract && npm run build",
    "icons": "tauri icon src/assets/virgostars-icon.svg",
    "android:init": "npm run icons && tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "npm run icons && tauri ios init",
    "ios:dev": "tauri ios dev"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@tauri-apps/api": "2.12.2",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1",
    "astronomy-engine": "2.1.19",
    "@tauri-apps/plugin-geolocation": "2.5.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.5",
    "@angular/cli": "20.3.5",
    "@angular/compiler-cli": "20.3.35",
    "@tauri-apps/cli": "2.12.2",
    "typescript": "5.8.3"
  }
}
