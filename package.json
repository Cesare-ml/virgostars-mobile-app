{
  "name": "virgostars-mobile-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Android-first, iOS-ready VirgoStars experimental offline-first mobile app",
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run prepare:charts && ng serve --host 0.0.0.0 --port 1420",
    "build": "npm run prepare:charts && ng build",
    "test:contract": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run test:contract && npm run build && npm run verify:chart-symbols",
    "icons": "tauri icon src/assets/virgostars-icon.png",
    "android:init": "npm run icons && tauri android init",
    "android:dev": "npm run icons && tauri android dev",
    "android:build": "npm run icons && tauri android build",
    "android:studio:swiss-arm64": "tauri android build --debug --target aarch64 --open --features swiss-ephemeris",
    "android:studio:swiss-x86_64": "tauri android build --debug --target x86_64 --open --features swiss-ephemeris",
    "ios:init": "npm run icons && tauri ios init",
    "ios:dev": "npm run icons && tauri ios dev",
    "prepare:charts": "node scripts/prepare-synthetic-frontend.mjs",
    "verify:chart-symbols": "node scripts/verify-chart-symbols.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@tauri-apps/api": "2.12.2",
    "astrological-functions": "file:../astrological-functions",
    "grafici-astrologici": "file:../astrological-charts/dist/grafici-astrologici",
    "gsap": "^3.15.1",
    "moment-timezone": "^0.5.48",
    "rxjs": "^7.8.0",
    "three": "^0.170.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.5",
    "@angular/cli": "20.3.5",
    "@angular/compiler-cli": "20.3.35",
    "@tauri-apps/cli": "2.12.2",
    "@types/three": "^0.170.0",
    "typescript": "5.8.3"
  }
}
